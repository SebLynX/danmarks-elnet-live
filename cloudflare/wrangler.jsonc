{
  // Site Worker for el.gridkort.dk. Does not attach the custom domain:
  // that DNS change is a cutover step, documented in docs/cloudflare-migration.md.
  // workers.dev stays on so the API Worker can read the files before DNS moves.
  "name": "el-gridkort",
  "main": "site.js",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/hist.json", "/data.json", "/prices.json"]
  }
}

node_modules/

# fetch.js mellemresultater. De hoerer ikke i repoet, og de maa isaer ikke
# ligge i mappen naar siden udgives: upload-pages-artifact tager "path: ."
# med alt hvad der ligger der, ogsaa filer git ikke sporer.
power_raw.json
history.json

# cloudflare/assemble.js writes this for wrangler. It is not part of the
# GitHub Pages tree: upload-pages-artifact publishes the checkout, and a
# generated copy of the site must not ride along.
cloudflare/dist/

# Local wrangler dev state. Not part of the site.
.wrangler/
